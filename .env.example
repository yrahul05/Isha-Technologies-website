# Contact form email delivery (see src/app/api/contact/route.ts)

# Internal enquiries are delivered to this address.
CONTACT_EMAIL=hello.ishatechnologies@gmail.com

# Verified sender identity for the email provider below, e.g.
# "Isha Technologies <hello@ishatechnologies.in>". Must be a sender/domain
# verified with your provider before it will deliver.
EMAIL_FROM=

# API key for the transactional email provider. src/lib/email.ts calls the
# Resend API (https://api.resend.com/emails) by default — swap that one
# function if you use a different provider. Never expose this in
# client-side code.
EMAIL_API_KEY=

# Google Analytics 4 Measurement ID (starts with "G-"), from the GA4 web
# data stream. Leave unset to skip loading GA4 entirely — the site behaves
# normally either way. See src/components/analytics/GoogleAnalytics.tsx.
# On Vercel, set the same key/value under Project -> Settings ->
# Environment Variables for Production and Preview so every deployment
# reports to the same GA4 property.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-98Z5JSM7P9

# ---------------------------------------------------------------------------
# Footer "Website Visitors" stat — Google Analytics 4 Data API
# (server-only, NOT NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# These back the Route Handler at src/app/api/analytics/visitors/route.ts,
# which reads real "sessions over the last 30 days" for ishatechnologies.in
# from the GA4 Data API, using a Google Cloud service account. On Vercel,
# set all three under Project -> Settings -> Environment Variables.
# GA4_PRIVATE_KEY MUST be added as a "Sensitive" (encrypted) variable,
# never a plain one, and none of these should ever be set with a
# NEXT_PUBLIC_ prefix. See docs/analytics-visitor-count.md for full setup
# steps (creating the service account, granting it Viewer access on the
# GA4 property, enabling the Data API).
#
# The GA4 property ID (Admin -> Property Settings). Not secret, but still
# kept server-side.
GA4_PROPERTY_ID=
# The service account's client_email, granted Viewer access on the GA4
# property above.
GA4_CLIENT_EMAIL=
# The service account's private_key (from the downloaded JSON key file).
# Secret — must stay empty here. Paste it with literal "\n" sequences for
# line breaks (as it appears in the JSON file) — the route normalizes
# those back to real newlines.
GA4_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Footer "Website Analytics" card — optional dashboard link
# ---------------------------------------------------------------------------
# Public, non-secret URL for the footer's "View Analytics" link (e.g. a
# GA4 dashboard URL). Leave unset to omit the link entirely — see
# src/components/layout/FooterVisitorStat.tsx, which never invents or
# defaults this value.
NEXT_PUBLIC_ANALYTICS_DASHBOARD_URL=
