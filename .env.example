# Contact form email delivery (see src/app/api/contact/route.ts)

# Internal enquiries are delivered to this address.
CONTACT_EMAIL=hello.ishatechnologies@gmail.com

# Verified sender identity for the email provider below, e.g.
# "Isha Technologies <hello@ishatechnologies.in>". Must be a sender/domain
# verified with your provider before it will deliver.
EMAIL_FROM=

# API key for the transactional email provider. src/lib/email.ts calls the
# Resend API (https://api.resend.com/emails) by default — swap that one
# function if you use a different provider. Never expose this in
# client-side code.
EMAIL_API_KEY=

# Google Analytics 4 Measurement ID (starts with "G-"), from the GA4 web
# data stream. Leave unset to skip loading GA4 entirely — the site behaves
# normally either way. See src/components/analytics/GoogleAnalytics.tsx.
# On Cloudflare Pages, set the same key/value under Workers & Pages ->
# (project) -> Settings -> Environment Variables for Production and
# Preview so every deployment reports to the same GA4 property.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-98Z5JSM7P9

# ---------------------------------------------------------------------------
# Footer "Website Visitors" stat — Cloudflare GraphQL Analytics API
# (server-only, NOT NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# These back the Route Handler at src/app/api/analytics/visitors/route.ts,
# which reads real "visits over the last 30 days" for ishatechnologies.in
# from https://api.cloudflare.com/client/v4/graphql. On the deployed
# Worker, set both as Cloudflare Worker Variables and Secrets (Workers &
# Pages -> isha-technologies-website -> Settings -> Variables and Secrets).
# CLOUDFLARE_API_TOKEN MUST be added as an encrypted Secret, never a plain
# text Variable, and must never be set with a NEXT_PUBLIC_ prefix. See
# docs/analytics-visitor-count.md for full setup steps.
#
# API token scoped to Zone > Analytics > Read for the ishatechnologies.in
# zone only. Secret — must stay empty here.
CLOUDFLARE_API_TOKEN=
# Zone ID for ishatechnologies.in (dashboard -> the domain -> Overview,
# right sidebar). Not secret, but still kept server-side.
CLOUDFLARE_ZONE_ID=

# ---------------------------------------------------------------------------
# Footer "Website Analytics" card — optional dashboard link
# ---------------------------------------------------------------------------
# Public, non-secret URL for the footer's "View Analytics" link (e.g. a
# Cloudflare Web Analytics or GA4 dashboard URL). Leave unset to omit the
# link entirely — see src/components/layout/FooterVisitorStat.tsx, which
# never invents or defaults this value.
NEXT_PUBLIC_ANALYTICS_DASHBOARD_URL=
